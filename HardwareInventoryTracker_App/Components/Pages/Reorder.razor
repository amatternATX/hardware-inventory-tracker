@page "/Reorder/{hardwareItemId:int?}"
@rendermode InteractiveServer

@using HardwareInventoryTracker_App.Components.Blocks
@using HardwareInventoryTracker_App.Models

@inject OrderHistoryRepo orderHistoryRepo
@inject HardwareItemRepo hardwareItemRepo

@inject NavigationManager NavManager

<PageTitle>Reorder @hardwareItem?.Name</PageTitle>

@if (hardwareItem is not null)
{
    <h1>Reorder for Item @hardwareItem.Name</h1>
    <div class="mb-3">@hardwareItem.Category.CategoryName</div>
    <div class="mb-3"><img src="@hardwareItem.ProductImageUrl" class="image-thumbnail" width="100" /></div>
    <div class="mb-3"><a href=@hardwareItem.ReorderLink" target="_blank">click to order</a></div>
    <div class="mb-3">Suggested order is @hardwareItem.SuggestedOrder units (@hardwareItem.PackageQuantitiy pieces per unit)</div>
    <div class="mb-3">Current Inventory is <strong>@hardwareItem.Quantity</strong></div>
}

@if (openOrders?.Count > 0)
{
    <div class="mb-3">
    <div class="text-danger">There @(openOrders.Count == 1 ? "is" : "are") @openOrders.Count open order@(openOrders.Count ==
                                    1 ? "" : "s"), would you like to fulfill one?</div>
        <OrderList HardwareItemId="hardwareItemId" ShowOpenOrders="true" />
    </div>
    }

    <div class="mb-3">
        <label for="unitsOrdered" class="form-label">Units ordered:</label>
        <input id="unitsOrdered" class="form-control" type="number" @bind="unitsOrdered" @bind:event="oninput" min="1" /> 
    </div>
    <div class="mb-3">
        <label for="costPerUnit" class="form-label">Cost per unit (USD):</label>
        <input id="costPerUnit" class="form-control" type="number" step="0.01" placeholder="0.00" @bind="cost" @bind:event="oninput" />
    </div>
<div class="mb-3">Total (USD): @TotalCost</div>

        <button class="btn btn-primary" @onclick="createOrder">Create order</button>

@code {

    [Parameter]
    public int? hardwareItemId { get; set; }
    private HardwareItem? hardwareItem;
    private IList<OrderHistory>? openOrders;

    private int unitsOrdered = 0;
    private decimal cost = 0;
    
    protected override async Task OnInitializedAsync()
    {
        if (hardwareItemId is not null)
        {
            hardwareItem = await hardwareItemRepo.GetByIdAsync(hardwareItemId.Value);
        
            var orderHistory = await orderHistoryRepo.GetAllAsync();
            openOrders = orderHistory.Where(o => o.HardwareItemId == hardwareItemId && o.FulfillmentDate is null).ToList();
        }
    }

    protected decimal TotalCost
    {
        get
        {
            return cost * unitsOrdered;
        }
    }

    protected async Task createOrder()
    {
        //check other fields - needs form validation
        if (hardwareItemId.HasValue)
        {
            var order = new OrderHistory()
            {
                HardwareItemId = hardwareItemId.Value,
                OrderDate = DateOnly.FromDateTime(DateTime.Now),
                OrderQuantity = unitsOrdered,
                OrderPrice = cost,
                OrderTotal = TotalCost
            };

            await orderHistoryRepo.AddAsync(order);
            NavManager.NavigateTo("/ordermanager");
        }
    }
}